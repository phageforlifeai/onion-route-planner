# Office-PC settings for the Onion Route Planner.
# Copy this file to  .env  (same folder as app.py) and fill in the values.
# Lines starting with # are ignored.

# Team password for the login screen (leave empty = no login, only for a PC nobody else can reach)
APP_PASSWORD=choose-a-team-password

# Share data with the Streamlit Cloud copy: paste the SAME Neon connection string you put in Streamlit's secrets.
# Leave empty to keep data in the local  data\  folder instead.
DATABASE_URL=

# Optional – Google Maps key for historic-traffic travel times (free allowance is enough for daily use)
GOOGLE_MAPS_API_KEY=
